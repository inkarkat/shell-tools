#!/bin/bash

EACHSPLIT=eachPrompt \
EACHSPLIT_USAGE_TOPICS="${EACHSPLIT_USAGE_TOPICS-piece-modifier input}" \
SPLITRECALL="${SPLITRECALL:-$(basename -- "${BASH_SOURCE[0]}")}" \
SPLITRECALL_WHAT='sections separated by prompts' \
    exec splitRecall --reverse --name-mapping "${EACHSPLIT_MAPPING_MARKER:-{M\}}" --elide-last --elide-empty-files --accept-single "$@"
