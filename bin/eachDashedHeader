#!/bin/bash

printUsage()
{
    eachHeader --help 2>&1 | sed \
	-e '1s#^.*$#Split standard input into sections separated by dashed "-- header lines -----"\n(as created by the HEADER_STYLE=dashed-line [with]Header commands) and execute\nCOMMAND with each section file (which either is appended or replaces any {}\nmarker inside COMMANDLINE).#' \
	-e '2b removeFirstParagraphLoop' \
	-e '/^Usage:$/N' -e '/\(^\|\n\)Usage: */{ s/\(^\|\n\)\(Usage: *\)\?\(\([^ |]\+ \)*\(| \)\?\)eachHeader /\1\2\3'"$(basename "$1")"' /; s/ \[EACHHEADER_STYLE=dashed-line\]//; }' \
	-e b -e :removeFirstParagraphLoop -e '{ /\(^\|\n\)$/{ s/^\(.*\n\)\?//; b; }; N; b removeFirstParagraphLoop; }' \
	-e b -e :removeOptionLoop -e '{ /\n *\(--foo|-f\)[^\n]*$/{ N; b removeOptionLoop; }; /\n *--[^\n]*$\|\n[^	 ]\|\n$/{ s/^\(.*\n\)\?//; b; }; N; b removeOptionLoop; }'
}
case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

EACHHEADER_STYLE=dashed-line \
    exec eachHeader "$@"
