#!/bin/bash

: ${EACHPROMPT_PATTERN:='^.*|[0-9]\{2\}-\(Jan\|Feb\|Mar\|Apr\|May\|Jun\|Jul\|Aug\|Sep\|Oct\|Nov\|Dec\)-[0-9]\{4\} [0-9]\{2\}:[0-9]\{2\}:[0-9]\{2\} \([^[:space:]]\+\) *$'}
: ${EACHPROMPT_SUBMATCH='\2'}

printUsage()
{
    eachSection --help 2>&1 | sed \
	-e '1s#^.*$#Split standard input into sections separated by prompts (as created by a shell'\''s\nPS1) and execute COMMAND with each section file (which either is appended or\nreplaces any {} marker inside COMMANDLINE).#' \
	-e '2b removeFirstParagraphLoop' \
	-e 's/old term/new term/g' \
	-e '/^ *\(--section-separator|-S\)/b removeOptionLoop' \
	-e '/^Usage:$/N' -e '/\(^\|\n\)Usage: */{ s/\(^\|\n\)\(Usage: *\)\?\(\([^ |]\+ \)*\(| \)\?\)eachSection /\1\2\3[EACHPROMPT_PATTERN=REGEXP] '"$(basename "$1")"' /; s/ \[-S|--section-separator PATTERN\]//; }' \
	-e b -e :removeFirstParagraphLoop -e '{ /\(^\|\n\)$/{ s/^\(.*\n\)\?//; b; }; N; b removeFirstParagraphLoop; }' \
	-e b -e :removeOptionLoop -e '{ /\n *\(--section-separator|-S\)[^\n]*$/{ N; b removeOptionLoop; }; /\n *--[^\n]*$\|\n[^	 ]\|\n$/{ s/^\(.*\n\)\?//; b; }; N; b removeOptionLoop; }'
}
case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

typeset -a infoExtractor=(
    sed -n
	-e 's/^[$#] //'
	-e '$T historyNumberFallback' -e T
	-e '/^[[:space:]]*$/b historyNumberFallback'

	-e 'h'
	-e "s/'/'\\\\''/g"
	-e "s/.*/COMMANDNAME_WRAPPERS='' commandName --eval --no-interpreter --undefined '' '&'/"
	-e e
	-e '/^[[:space:]]*$/{ g; b historyNumberFallback; }'
	-e p
	-e q

	-e ':historyNumberFallback'
	-e '$!{ N; b historyNumberFallback; }'
	-e "\$s/${EACHPROMPT_PATTERN}/${EACHPROMPT_SUBMATCH}/"	# Extract the !history-number / custom ID from the prompt.
	-e 't havePrompt'
	-e 'Q 1'
	-e :havePrompt
	-e 's/^[0-9]\+$/#&/'	# If it's just a number, prefix it with # to avoid confusion with the selection by number.
	-e p
)

exec eachSection \
    --elide-empty-first --elide-empty-last \
    --section-separator "$EACHPROMPT_PATTERN" \
    --section-info-extractor-exec "${infoExtractor[@]}" "${EACHSPLIT_EXTRACTOR_MARKER:-{\}}" "${EACHSPLIT_EXTRACTOR_END:-;}" \
    --section-info-include-separator below \
    "$@"
