#!/bin/bash

printUsage()
{
    eachSection --help 2>&1 | sed \
	-e '1s#^.*$#Split standard input into paragraphs separated by an empty line and execute\nCOMMAND with each paragraph file (which either is appended or replaces any\n{} marker inside COMMANDLINE).#' \
	-e '2b removeFirstParagraphLoop' \
	-e '/^ *\(--section-separator|-S\|--elide-empty-files|-z\)/b removeOptionLoop' \
	-e '/^Usage:$/N' -e '/\(^\|\n\)Usage: */{ s/\(^\|\n\)\(Usage: *\)\?\(\([^ |]\+ \)*\(| \)\?\)eachSection /\1\2\3'"$(basename "$1")"' /; s/ \[-S|--section-separator PATTERN\]//; s/ \[-z|--elide-empty-files]//; }' \
	-e b -e :removeFirstParagraphLoop -e '{ /\(^\|\n\)$/{ s/^\(.*\n\)\?//; b; }; N; b removeFirstParagraphLoop; }' \
	-e b -e :removeOptionLoop -e '{ /\n *\(--section-separator|-S\|--elide-empty-files|-z\)[^\n]*$/{ N; b removeOptionLoop; }; /\n *--[^\n]*$\|\n[^	 ]\|\n$/{ s/^\(.*\n\)\?//; b; }; N; b removeOptionLoop; }'
}
case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

exec eachSection --section-separator '^$' --elide-empty-files "$@"
