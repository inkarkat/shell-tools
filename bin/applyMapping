#!/bin/bash
set -o pipefail

${DEBUG:+eval $(debugtrace -o $- -- "$@")}

: ${APPLYMAPPING_COMMAND_JOINER=;}
: ${APPLYMAPPING_EXEC_END=;}

getShortUsage()
{
    local usageSep
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local hadTopic=
	case "$1" in
	    ''|mapping)
		printf %s "${usageSep}${hadTopic:+ }" '-m|--mapping-file MAPPING-FILE|- [-F|--field-separator FS]'; hadTopic=t;;&
	    ''|command-outputs)
		printf %s "${usageSep}${hadTopic:+ }" '[-1|--stdout|-2|--stderr]'; hadTopic=t;;&
	    ''|commands)
		printf %s "${usageSep}${hadTopic:+ }" "-c|--command \"COMMANDLINE\" [-c ...] | --exec SIMPLECOMMAND [...] ${APPLYMAPPING_EXEC_END} [--exec ...]"; hadTopic=t;;&
	    ''|inputs)
		printf %s "${usageSep}${hadTopic:+ }" '-f|--file FILE [-f ...]'; hadTopic=t;;&
	    ''|stdin)
		printf %s "${usageSep}${hadTopic:+ }" '--stdin'; hadTopic=t;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown short usage topic \"$1\"!" >&2; return 2; };;
	esac
	shift; usageSep=' '
    done
}
getLongUsage()
{
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local topic="$1"; shift
	local hadTopic=
	#local optionName="${1:?}"; shift
	#local description="$1"; shift
	case "$topic" in
	    ''|mapping)
		cat <<HELPTEXT
    --mapping-file|-m MAPPING-FILE
			Read KEY VALUE pairs from the passed MAPPING-FILE.
    --field-separator|-F FS
			Use FS as the input field separator (as with AWK).
HELPTEXT
		hadTopic=t
		;;&
	    ''|command-outputs)
		cat <<HELPTEXT
    --stdout|-1		Only substitute in standard output.
    --stderr|-2		Only substitute in error output.
HELPTEXT
		hadTopic=t
		;;&
	    ''|commands)
		cat <<HELPTEXT
    --command|-c CMD	Execute CMD as a command-line and substitute in its
			output.
    --exec CMD [...] ${APPLYMAPPING_EXEC_END}	Execute CMD and substitute in its output; all following
			arguments are taken to be arguments to the CMD until an
			argument consisting of '${APPLYMAPPING_EXEC_END}' is encountered.
HELPTEXT
		hadTopic=t
		;;&
	    ''|inputs)
		cat <<HELPTEXT
    --file|-f FILE	Substitute in passed FILE(s).
HELPTEXT
		hadTopic=t
		;;&
	    ''|stdin)
		cat <<HELPTEXT
    --stdin		Substitute in standard input instead of FILE(s) or
			COMMAND output.
HELPTEXT
		hadTopic=t
		;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown long usage topic \"$topic\"!" >&2; return 2; };;
	esac
    done
}
printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" "$(getShortUsage mapping) [-?|-h|--help] ..."
    printf 'Usage: %q %s\n' "$(basename "$1")" "... $(getShortUsage command-outputs commands) | [--] SIMPLECOMMAND [...]"
    printf 'Usage: %q %s\n' "$(basename "$1")" "... $(getShortUsage inputs)"
    printf 'Usage: cat FILE [...] | %q %s\n' "$(basename "$1")" "... $(getShortUsage stdin)"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Read KEY VALUE pairs from the passed MAPPING-FILE and substitute each occurrence
of KEY with the corresponding VALUE in FILE(s) / the output of COMMAND(s).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    getLongUsage
    cat <<HELPTEXT
EXIT STATUS:
    0	Complete success.
    2	Bad invocation, wrong or missing command-line arguments.
    3	Internal error or failed assertion.
    *	Any exit status from COMMAND(s).
HELPTEXT
}

mappingFilespec=
typeset -a awkArgs=()
typeset -a files=()
commands=
typeset -a mapDescriptors=()
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--get-short-usage)
			shift; getShortUsage "$@"; exit $?;;
	--get-long-usage)
			shift; getLongUsage "$@"; exit $?;;

	--mapping-file|-m)
			shift; mappingFilespec="${1:?}"; shift;;
	--field-separator|-F)
			awkArgs+=("$1" "${2:?}"); shift; shift;;
	--stdin)	shift; files+=(-);;
	--file|-f)	shift; files+=("${1:?}"); shift;;

	--stdout|-1)	shift; mapDescriptors[0]=1;;
	--stderr|-2)	shift; mapDescriptors[1]=2;;
	--command|-c)	shift; commands+="${commands:+ $APPLYMAPPING_COMMAND_JOINER }$1"; shift;;
	--exec)		shift
			cmd=
			while [ $# -gt 0 -a "$1" != "$APPLYMAPPING_EXEC_END" ]
			do
			    printf -v quotedArg %q "$1"
			    cmd+="${cmd:+ }${quotedArg}"
			    shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --exec command must be concluded with '${APPLYMAPPING_EXEC_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			commands+="${commands:+ $APPLYMAPPING_COMMAND_JOINER }${cmd}"
			;;
	--)		shift; break;;
	-)		break;; # For supporting special - FILE without prior --
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -ne 0 ]; then
    # Combine --command and SIMPLECOMMAND; need to quote SIMPLECOMMAND to
    # undo the effects of eval.
    printf -v quotedSimpleCommand '%q ' "$@"
    commands+="${commands:+ $APPLYMAPPING_COMMAND_JOINER }${quotedSimpleCommand% }"
fi
if [ -z "$mappingFilespec" ]; then
    echo 'ERROR: No MAPPING-FILE passed.'
    echo
    printUsage "$0"
    exit 2
elif [ -z "$commands" -a ${#files[@]} -eq 0 ]; then
    echo "ERROR: No FILE(s) or COMMAND(s) specified; need to pass -f|--file FILE, or -c|--command \"COMMANDLINE\", or --exec SIMPLECOMMAND [...] $APPLYMAPPING_EXEC_END or SIMPLECOMMAND."
    echo
    printUsage "$0"
    exit 2
elif [ -n "$commands" -a ${#files[@]} -gt 0 ]; then
    echo 'ERROR: Cannot specify both FILE(s) and COMMAND(s).'
    echo
    printUsage "$0"
    exit 2
fi >&2
[ ${#mapDescriptors[@]} -gt 0 ] || mapDescriptors=(1 2)

map()
{
    awk "${awkArgs[@]}" '
NR == FNR {
    if (NF >= 2) {
	key = $1
	$1 = ""; sub(OFS, "")
	literalKey = gensub(/[][\\$*+?{}.|()^]/, "\\\\&", "g", key)
	literalValue = gensub(/[\\&]/, "\\\\&", "g", $0)

	if (literalKey in mapping) {
	    print "Warning: Duplicate key: " key > "/dev/stderr"
	} else {
	    keys[++keyNum] = literalKey
	    mapping[literalKey] = literalValue
	}
    }
    next
}
{
    for (i = 1; i <= keyNum; ++i) {
	$0 = gensub(keys[i], mapping[keys[i]], "g", $0)
    }
    print
}
' "$mappingFilespec" "$@"
}

${DEBUG:+eval $(debugtrace --point main -o $- --)}

if [ ${#files[@]} -gt 0 ]; then
    map "${files[@]}"
else
    case "${mapDescriptors[0]}${mapDescriptors[1]}" in
	1)  eval "$commands" | map -;;
	2)  { eval "$commands" 6>&1 1>&2 2>&6 6>&- | map -; } 6>&1 1>&2 2>&6 6>&-;;
	12) { eval "$commands" 6>&1 1>&2 2>&6 6>&- | map -; } 6>&1 1>&2 2>&6 6>&- | map -;;
	*)  printf >&2 'ASSERT: Invalid mapDescriptors: %s\n' "${mapDescriptors[*]}"; exit 3;;
    esac
fi
