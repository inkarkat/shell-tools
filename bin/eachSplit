#!/bin/bash
set -o pipefail
shopt -qs extglob nullglob

${DEBUG:+eval $(debugtrace -o $- -- "$@")}

: ${EACHSPLIT_COMMAND_JOINER=;}
: ${EACHSPLIT_EXEC_END=;}
: ${EACHSPLIT_FILE_MARKER='{}'}
fileMarker="$EACHSPLIT_FILE_MARKER"; unset EACHSPLIT_FILE_MARKER
: ${EACHSPLIT_IDENTIFIER_MARKER='{I}'}
identifierMarker="$EACHSPLIT_IDENTIFIER_MARKER"; unset EACHSPLIT_IDENTIFIER_MARKER
: ${EACHSPLIT_GLOB_MARKER='{G}'}
globMarker="$EACHSPLIT_GLOB_MARKER"; unset EACHSPLIT_GLOB_MARKER
: ${EACHSPLIT_MAPPING_MARKER='{M}'}
mappingMarker="$EACHSPLIT_MAPPING_MARKER"; unset EACHSPLIT_MAPPING_MARKER
: ${EACHSPLIT_EXTRACTOR_MARKER='{}'}
extractorMarker="$EACHSPLIT_EXTRACTOR_MARKER"; unset EACHSPLIT_EXTRACTOR_MARKER
: ${EACHSPLIT_EXTRACTOR_JOINER=;}
: ${EACHSPLIT_EXTRACTOR_END=;}
: ${EACHSPLIT_MODIFIER_MARKER='{}'}
modifierMarker="$EACHSPLIT_MODIFIER_MARKER"; unset EACHSPLIT_MODIFIER_MARKER
: ${EACHSPLIT_MODIFIER_JOINER=;}
: ${EACHSPLIT_MODIFIER_END=;}
: ${EACHSPLIT_SPLITTER_END=;}
: ${EACHSPLIT_FILE_PREFIX=piece-}
: ${EACHSPLIT_NO_PIECE_STATUS:=99}

hasProgressNotification=; type -t progressNotification >/dev/null && hasProgressNotification=t

getShortUsage()
{
    local usageSep
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local hadTopic=
	case "$1" in
	    ''|split)
		printf %s "${usageSep}${hadTopic:+ }" "[--splitter SPLIT-COMMAND OPTIONS FILE PREFIX ARGS ${EACHSPLIT_SPLITTER_END}] [SPLIT-OPTIONS ...] [--elide-empty-first]"; hadTopic=t;;&
	    ''|piece-info)
		printf %s "${usageSep}${hadTopic:+ }" "[--piece-info-extractor-command COMMANDLINE|--piece-info-extractor-exec CMD [...]${extractorMarker:+ [}${extractorMarker}${extractorMarker:+] [...]} ${EACHSPLIT_EXTRACTOR_END}]"; hadTopic=t;;&
	    ''|piece-modifier)
		printf %s "${usageSep}${hadTopic:+ }" "[--piece-modifier-command COMMANDLINE|--piece-modifier-exec CMD [...]${modifierMarker:+ [}${modifierMarker}${modifierMarker:+] [...]} ${EACHSPLIT_MODIFIER_END}]"; hadTopic=t;;&
	    ''|iteration)
		printf %s "${usageSep}${hadTopic:+ }" "${hasProgressNotification:+[--progress SINK] }[--with-header [--separate-errors] [--color=(always|auto|never)|--no-color]|--with-prompt $(runWithPrompt --get-short-usage 2>/dev/null)] -c|--command \"COMMANDLINE\" [-c ...] | --exec SIMPLECOMMAND [...]${identifierMarker:+ [${identifierMarker}]}${fileMarker:+ [}${fileMarker}${fileMarker:+] [...]} ${EACHSPLIT_EXEC_END} [--exec ...] | -- SIMPLECOMMAND [...]"; hadTopic=t;;&
	    ''|consumer)
		printf %s "${usageSep}${hadTopic:+ }" "-C|--consumer-command \"COMMANDLINE\" [-C ...] | --consumer-exec SIMPLECOMMAND [...]${mappingMarker:+ [${mappingMarker}]}${fileMarker:+ [}${fileMarker}${fileMarker:+] [...]} ${EACHSPLIT_EXEC_END} [--consumer-exec ...]"; hadTopic=t;;&
	    ''|input)
		printf %s "${usageSep}${hadTopic:+ }" '-f|--file FILE'; hadTopic=t;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown short usage topic \"$1\"!" >&2; return 2; };;
	esac
	shift; usageSep=' '
    done
}
getLongUsage()
{
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local topic="$1"; shift
	local hadTopic=
	case "$topic" in
	    ''|split)
		cat <<HELPTEXT
    --splitter SPLIT-COMMAND OPTIONS FILE PREFIX ARGS ${EACHSPLIT_SPLITTER_END}
			Use a different split command; OPTIONS, FILE, PREFIX,
			and ARGS are replaced by the passed SPLIT-OPTIONS, input
			file, output directory + file prefix, and trailing ARGS
			respectively.
    --elide-empty-first	If the splitter creates an empty first file, remove it
			before iteration.
HELPTEXT
		hadTopic=t
		;;&
	    ''|piece-info)
		cat <<HELPTEXT
    --piece-info-extractor-command CMD
			Use CMD to extract the piece identifier (from the
			piece contents). FILEs ${fileMarker:+either }are appended${extractorMarker:+
			or replace any $extractorMarker marker} inside CMD.
    --piece-info-extractor-exec CMD [...] ${EACHSPLIT_EXTRACTOR_END}
			Use CMD to extract the piece identifier (from the
			piece contents); all following arguments are taken to
			be arguments to the CMD until an argument consisting of
			'${EACHSPLIT_EXTRACTOR_END}' is encountered. FILEs ${fileMarker:+either }are appended${extractorMarker:+ or replace
			any $extractorMarker marker} inside CMD.
HELPTEXT
		hadTopic=t
		;;&
	    ''|piece-modifier)
		cat <<HELPTEXT
    --piece-modifier-command CMD
			Use CMD to modify each piece file before passing it to
			COMMAND (but after piece info extraction). FILEs${fileMarker:+ either}
			are appended${extractorMarker:+ or replace any $extractorMarker marker} inside CMD.
			If the CMD fails, the piece file is skipped and COMMAND
			is not executed for that piece.
    --piece-modifier-exec CMD [...] ${EACHSPLIT_EXTRACTOR_END}
			Use CMD to modify each piece file before passing it to
			COMMAND (but after piece info extraction); all following
			arguments are taken to be arguments to the CMD until an
			argument consisting of '${EACHSPLIT_EXTRACTOR_END}' is encountered. FILEs${fileMarker:+ either}
			are appended${extractorMarker:+ or replace any $extractorMarker marker} inside CMD.
			If the CMD fails, the piece file is skipped and COMMAND
			is not executed for that piece.
HELPTEXT
		hadTopic=t
		;;&
	    ''|iteration)
		cat <<HELPTEXT
${hasProgressNotification:+    --progress SINK	Report the current piece through one of the SINKs of
			the progressNotification command.
}    --with-header	Print a header (containing the current ARGUMENT) before
			each execution if COMMAND produces output.
    --separate-errors	Do not combine command output and command errors into
			one (paged) stream. Commands that just cause error
			output won't have a header then. Error output will
			remain on its separate file descriptor and will not be
			paged. Useful if you want to suppress errors or handle
			them separately.
    --with-prompt	Emulate a full prompt (as if invoking COMMAND) before
			each execution.
HELPTEXT
    runWithPrompt --get-long-usage 2>/dev/null
    cat <<HELPTEXT
    --command|-c CMD	Execute CMD as a command-line. FILEs ${fileMarker:+either }are appended
			${fileMarker:+or replace any $fileMarker marker }inside COMMANDLINE.${identifierMarker:+
			Furthermore, ${identifierMarker} is replaced with the piece filename /
			extracted piece info inside COMMANDLINE.}
    --exec CMD [...] ${EACHSPLIT_EXEC_END}	Execute CMD; all following arguments are taken to be
			arguments to the CMD until an argument consisting of
			'${EACHSPLIT_EXEC_END}' is encountered. FILEs ${fileMarker:+either }are appended${fileMarker:+ or replace
			any $fileMarker marker} inside COMMANDLINE.${identifierMarker:+
			Furthermore, ${identifierMarker} is replaced with the piece filename /
			extracted piece info inside COMMANDLINE.}
HELPTEXT
		hadTopic=t
		;;&
	    ''|consumer)
		cat <<HELPTEXT
    --consumer-command|-C CMD
			Execute CMD once as a command-line to work on all split
			pieces at once. ${fileMarker:+Any $fileMarker marker is replaced with a catalog
			file that lists all split piece filespecs.}
			${globMarker:+Any $globMarker marker is replaced with a glob pattern that
			matches all split piece filespecs.}
			${mappingMarker:+Any $mappingMarker marker is replaced with a mapping file that maps
			each split piece filespec to the corresponding extracted
			piece info.} ${fileMarker:+If no marker is given, }all piece filespecs
			are directly appended to CMD.
    --consumer-exec CMD [...] ${EACHSPLIT_EXEC_END}
			Execute CMD once as a command-line to work on all split
			pieces at once; all following arguments are taken to be
			arguments to the CMD until an argument consisting of
			'${EACHSPLIT_EXEC_END}' is encountered. ${fileMarker:+Any $fileMarker marker is replaced with a
			catalog file that lists all split piece filespecs.}
			${globMarker:+Any $globMarker marker is replaced with a glob pattern that
			matches all split piece filespecs.}
			${mappingMarker:+Any $mappingMarker marker is replaced with a mapping file that maps
			each split piece filespec to the corresponding extracted
			piece info.} ${fileMarker:+If no marker is given, }all piece filespecs
			are directly appended to CMD.
HELPTEXT
		hadTopic=t
		;;&
	    ''|input)
		cat <<HELPTEXT
    --file|-f FILE	Split pieces from FILE instead of standard input.
HELPTEXT
		hadTopic=t
		;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown long usage topic \"$topic\"!" >&2; return 2; };;
	esac
    done
}
printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, they can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" "$(getShortUsage split piece-info piece-modifier) [-?|-h|--help] ..."
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" "... $(getShortUsage iteration)"
    printf 'Usage: %q %s\n' "$(basename "$1")" "... $(getShortUsage consumer)"
    echo
    printf 'Usage: cat FILE [...] | %q %s\n' "$(basename "$1")" '...'
    printf 'Usage: %q %s\n' "$(basename "$1")" "$(getShortUsage input) ..."
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Split standard input into pieces and execute COMMAND with each piece file
(which ${fileMarker:+either }is appended${fileMarker:+ or replaces any $fileMarker marker} inside COMMANDLINE).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    getLongUsage ''
    echo
    cat <<HELPTEXT
SEE ALSO:
- eachFile directly operates on individual files.

EXIT STATUS:
Overall exit status is the highest status of all. If you specify any
runWith[Prompt] argument, --worst-status needs to be explicitly passed.
Consumer-command(s) run after commands on individual piece files, and only if
those have all succeeded.
    $EACHSPLIT_NO_PIECE_STATUS: No pieces were found.
HELPTEXT
}

progressSink=
with=
errorRedir='2>&1'
typeset -a colorArg=()
filespec=-
additionalSuccessStatus=
pieceInfoExtractorCommand=
pieceModifierCommand=
commands=
consumerCommands=
typeset -a splitCommand=(split OPTIONS ARGS FILE PREFIX)
typeset -a splitOptions=()
typeset -a splitArgs=()
isElideEmptyFirst=
option() { :; }
parameter() { :; }
parameterToSep() { :; }
argCount() { :; }
endOfOptionsAndParameters() { :; }
noUnderstand() { :; }
typeset -A understandsSubtopics=()
isUnderstandSubtopic() {
    [ $# -gt 0 -a ${#understandsSubtopics[@]} -gt 0 ] || return 0
    local subtopic; for subtopic
    do
	[ "${understandsSubtopics["$subtopic"]}" ] && return 0
    done
    return 1
}
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--get-short-usage)
			shift; getShortUsage "$@"; exit $?;;
	--get-long-usage)
			shift; getLongUsage "$@"; exit $?;;
	--understand-for)
			shift; understandsSubtopics["$1"]=t; shift;;
	--understands)	shift
			option() { isUnderstandSubtopic "$@" || exit 1; printf 1; exit 0; }
			parameter() { isUnderstandSubtopic "$@" || exit 1; printf 2; exit 0; }
			parameterToSep() { argCount "$@"; }
			argCount() { local argCount="${1:?}"; shift; isUnderstandSubtopic "$@" || exit 1; printf $argCount; exit 0; }
			endOfOptionsAndParameters() { exit 99; }
			noUnderstand() { exit 1; }
			;;

	--splitter)	originalArgNum=$#; shift
			splitCommand=()
			while [ $# -gt 0 -a "$1" != "$EACHSPLIT_SPLITTER_END" ]
			do
			    splitCommand+=("$1")
			    shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --splitter must be concluded with '${EACHSPLIT_SPLITTER_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			if [ ${#splitCommand[@]} -eq 0 ]; then
			    echo 'ERROR: --splitter must be followed by at least one ARGUMENT.'; echo; printUsage "$0"
			    exit 2
			fi >&2
			argCount $((originalArgNum - $#)) split
			;;
	--elide-empty-first)
			shift; isElideEmptyFirst=t; option split;;

	--file|-f)	shift; filespec="${1:?}"; shift; parameter input;;
	--file=*)	filespec="${1#--file=}"; shift; option input;;
	-f*)		filespec="${1#-f}"; shift; option input;;

	--progress)	shift; progressSink="$1"; shift; option iteration;;
	--with-header)	shift; with=header; option iteration;;
	--separate-errors)
			shift; errorRedir=''; option iteration;;
	--no-color|--color=*)	colorArg=("$1"); shift; option iteration;;
	--with-prompt)	shift; with=runWithPrompt; option iteration;;

	--piece-info-extractor-command)
			shift; pieceInfoExtractorCommand+="${pieceInfoExtractorCommand:+ $EACHSPLIT_EXTRACTOR_JOINER }${1:?}"; shift; parameter piece-info;;
	--piece-info-extractor-exec)
			originalArgNum=$#; shift
			cmd=
			printf -v escapedExtractorMarker %q "$extractorMarker"
			while [ $# -gt 0 -a "$1" != "$EACHSPLIT_EXTRACTOR_END" ]
			do
			    printf -v quotedArg %q "$1"
			    cmd+="${cmd:+ }${quotedArg//"$escapedExtractorMarker"/$extractorMarker}"	# %q escapes {}, we don't want that to have it interpolated later.
			    shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --piece-info-extractor-exec command must be concluded with '${EACHSPLIT_EXTRACTOR_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			pieceInfoExtractorCommand+="${pieceInfoExtractorCommand:+ $EACHSPLIT_EXTRACTOR_JOINER }${cmd}"
			argCount $((originalArgNum - $#)) piece-info
			;;
	--piece-modifier-command)
			shift; pieceModifierCommand+="${pieceModifierCommand:+ $EACHSPLIT_MODIFIER_JOINER }${1:?}"; shift; parameter piece-modifier;;
	--piece-modifier-exec)
			originalArgNum=$#; shift
			cmd=
			printf -v escapedModifierMarker %q "$modifierMarker"
			while [ $# -gt 0 -a "$1" != "$EACHSPLIT_MODIFIER_END" ]
			do
			    printf -v quotedArg %q "$1"
			    cmd+="${cmd:+ }${quotedArg//"$escapedModifierMarker"/$modifierMarker}"	# %q escapes {}, we don't want that to have it interpolated later.
			    shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --piece-modifier-exec command must be concluded with '${EACHSPLIT_MODIFIER_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			pieceModifierCommand+="${pieceModifierCommand:+ $EACHSPLIT_MODIFIER_JOINER }${cmd}"
			argCount $((originalArgNum - $#)) piece-modifier
			;;
	--command|-c)	shift; commands+="${commands:+ $EACHSPLIT_COMMAND_JOINER }$1"; shift; parameter iteration;;
	--exec)		originalArgNum=$#; shift
			cmd=
			printf -v escapedFileMarker %q "$fileMarker"
			printf -v escapedIdentifierMarker %q "$identifierMarker"
			while [ $# -gt 0 -a "$1" != "$EACHSPLIT_EXEC_END" ]
			do
			    printf -v quotedArg %q "$1"
			    # %q escapes {} and {I}, we don't want that to have it interpolated later.
			    quotedArg="${quotedArg//"$escapedFileMarker"/$fileMarker}"
			    quotedArg="${quotedArg//"$escapedIdentifierMarker"/$identifierMarker}"
			    cmd+="${cmd:+ }${quotedArg}"
			    shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --exec command must be concluded with '${EACHSPLIT_EXEC_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			commands+="${commands:+ $EACHSPLIT_COMMAND_JOINER }${cmd}"
			argCount $((originalArgNum - $#)) iteration
			;;
	--consumer-command|-C)
			shift; consumerCommands+="${consumerCommands:+ $EACHSPLIT_COMMAND_JOINER }$1"; shift; parameter consumer;;
	--consumer-exec)
			originalArgNum=$#; shift
			cmd=
			printf -v escapedFileMarker %q "$fileMarker"
			printf -v escapedGlobMarker %q "$globMarker"
			printf -v escapedMappingMarker %q "$mappingMarker"
			while [ $# -gt 0 -a "$1" != "$EACHSPLIT_EXEC_END" ]
			do
			    printf -v quotedArg %q "$1"
			    # %q escapes {} and {M}, we don't want that to have it interpolated later.
			    quotedArg="${quotedArg//"$escapedFileMarker"/$fileMarker}"
			    quotedArg="${quotedArg//"$escapedGlobMarker"/$globMarker}"
			    quotedArg="${quotedArg//"$escapedMappingMarker"/$mappingMarker}"
			    cmd+="${cmd:+ }${quotedArg}"
			    shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --consumer-exec command must be concluded with '${EACHSPLIT_EXEC_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			consumerCommands+="${consumerCommands:+ $EACHSPLIT_COMMAND_JOINER }${cmd}"
			argCount $((originalArgNum - $#)) consumer
			;;
	--status-99-is-noop)
			runWithPromptArgs+=("$1"); shift; additionalSuccessStatus=99; option iteration;;
	--)		endOfOptionsAndParameters; shift; break;;
	-*)		if argCount=$(runWithPrompt --understands "$@"); then
			    runWithPromptArgs+=("${@:1:argCount}")
			    shift $argCount
			    : ${with:=runWith}
			    argCount $argCount iteration
			elif [ $? -eq 2 ]; then
			    exit 2
			else
			    # Note: Parsing of [c]split options is necessary to correctly recognize
			    # parameters (e.g. -b 100); otherwise it would put -b into splitOptions and 100
			    # into splitArgs. The one-arg form --bytes=100 doesn't have that problem.
			    case "${splitCommand[0]}" in
				split)
				    case "$1" in
					-+([deu]))
						splitOptions+=("$1"); shift; option split;;
					--@(elide-empty-files|numeric-suffixes|hex-suffixes|unbuffered))
						splitOptions+=("$1"); shift; option split;;
					-[abClnt])
						splitOptions+=("$1" "${2?}"); shift; shift; parameter split;;
					--@(suffix-length|additional-suffix|line-bytes|numeric-suffixes|hex-suffixes|filter|lines|number|separator)=*)
						splitOptions+=("$1"); shift; option split;;
					--@(suffix-length|additional-suffix|line-bytes|filter|lines|number|separator))
						splitOptions+=("$1" "${2?}"); shift; shift; parameter split;;
					*)	noUnderstand; splitOptions+=("$1"); shift;; # Only understand split options when asked, but accept anything in real life.
				    esac
				    ;;
				csplit)
				    case "$1" in
					-+([ksz]))
						splitOptions+=("$1"); shift; option split;;
					--@(keep-files|suppress-matched|quiet|silent|elide-empty-files))
						splitOptions+=("$1"); shift; option split;;
					-[bfn])
						splitOptions+=("$1" "${2?}"); shift; shift; parameter split;;
					--@(suffix-format|prefix|digits))
						splitOptions+=("$1" "${2?}"); shift; shift; parameter split;;
					*)	noUnderstand; splitOptions+=("$1"); shift;; # Only understand csplit options when asked, but accept anything in real life.
				    esac
				    ;;
				*)  splitOptions+=("$1"); shift; argCount 1 split;;
			    esac
			fi
			;;
	*)		splitArgs+=("$1"); shift; argCount 1 split;;
    esac
done

if [ $# -ne 0 ]; then
    # Combine --command and SIMPLECOMMAND; need to quote SIMPLECOMMAND to
    # undo the effects of eval.
    printf -v quotedSimpleCommand '%q ' "$@"
    printf -v escapedFileMarker %q "$fileMarker"
    printf -v escapedIdentifierMarker %q "$identifierMarker"
    # %q escapes {} and {I}, we don't want that to have it interpolated later.
    quotedSimpleCommand="${quotedSimpleCommand//"$escapedFileMarker"/$fileMarker}"
    quotedSimpleCommand="${quotedSimpleCommand//"$escapedIdentifierMarker"/$identifierMarker}"
    commands+="${commands:+ $EACHSPLIT_COMMAND_JOINER }${quotedSimpleCommand}"
fi
if [ -z "$commands" -a -z "$consumerCommands" ]; then
    echo "ERROR: No COMMAND(s) specified; need to pass -c|--command \"COMMANDLINE\", or --exec SIMPLECOMMAND [...] ${EACHSPLIT_EXEC_END}, or -C|--consumer-command \"COMMANDLINE\", or --consumer-exec SIMPLECOMMAND [...] $EACHSPLIT_EXEC_END or SIMPLECOMMAND."
    echo
    printUsage "$0"
    exit 2
elif [ ${#runWithPromptArgs[@]} -gt 0 -a "$with" = 'header' ]; then
    echo 'ERROR: Cannot combine runWith[Prompt] arguments with --with-header.'
    echo
    printUsage "$0"
    exit 2
fi >&2

tempDirspec="$(mktemp --directory --tmpdir "$(basename -- "$0")-XXXXXX" 2>/dev/null || { dirspec="${TMPDIR:-/tmp}/$(basename -- "$0").$$$RANDOM"; mkdir --parents -- "$dirspec" && printf %s "$dirspec"; })" || exit 3
trap '${DEBUG:+debugcommand --} rm -rf -- "$tempDirspec" 2>/dev/null' EXIT

typeset -a tempArray=()
for c in "${splitCommand[@]}"
do
    case "$c" in
	ARGS)	    tempArray+=("${splitArgs[@]}");;
	OPTIONS)    tempArray+=("${splitOptions[@]}");;
	*)	    tempArray+=("$c");;
    esac
done
splitCommand=("${tempArray[@]}")
splitCommand=("${splitCommand[@]//FILE/"$filespec"}")
splitCommand=("${splitCommand[@]//PREFIX/"${tempDirspec}/${EACHSPLIT_FILE_PREFIX}"}")

${DEBUG:+debugcommand --module splitter --} "${splitCommand[@]}" || exit $?
typeset -a pieceFiles=("${tempDirspec}/${EACHSPLIT_FILE_PREFIX}"*)
if [ "$isElideEmptyFirst" ] && [ -f "${pieceFiles[0]}" -a ! -s "${pieceFiles[0]}" ]; then
    rm --force -- "${pieceFiles[0]}"
    pieceFiles=("${pieceFiles[@]:1}")
fi
if [ ${#pieceFiles[@]} -eq 0 ]; then
    exit $EACHSPLIT_NO_PIECE_STATUS
fi

if [ "$hasProgressNotification" ] && [ -n "$progressSink" ]; then
    typeset -a progressNotificationCommand=(progressNotification --to "$progressSink" ${EACHARG_ARG_WHAT:+--prepend-count "$EACHARG_ARG_WHAT"} --count-to $#)
fi

getPieceInfo()
{
    local pieceFile="${1:?}"; shift
    if [ -z "$pieceInfoExtractorCommand" ]; then
	printf %s "${pieceFile##*/}"
	return 0
    fi

    local quotedPieceFile; printf -v quotedPieceFile '%q' "$pieceFile"
    local interpolatedPieceInfoExtractorCommand="${pieceInfoExtractorCommand//"$extractorMarker"/$quotedPieceFile}"
    [ "$interpolatedPieceInfoExtractorCommand" = "$pieceInfoExtractorCommand" ] || quotedPieceFile=''
    eval "$interpolatedPieceInfoExtractorCommand" "$quotedPieceFile"
}

modifyPieceFile()
{
    [ -n "$pieceModifierCommand" ] || return 0

    local pieceFile="${1:?}"; shift
    local quotedPieceFile; printf -v quotedPieceFile '%q' "$pieceFile"
    local interpolatedPieceModifierCommand="${pieceModifierCommand//"$modifierMarker"/$quotedPieceFile}"
    [ "$interpolatedPieceModifierCommand" = "$pieceModifierCommand" ] || quotedPieceFile=''
    eval "$interpolatedPieceModifierCommand" "$quotedPieceFile"
}

[ -n "$with" -a -z "$commands" ] && with='' # No need for runWith[Prompt] if there are no commands to run on each piece.
isHeader=
case "$with" in
    runWith*)
	[ ${#runWithPromptArgs[@]} -eq 0 ] && runWithPromptArgs=(--worst-status)
	{
	    if [ "$hasProgressNotification" ] && [ -n "$progressSink" ]; then
		printf ' exec 4> >('
		printf '%q ' "${progressNotificationCommand[@]}"
		printf '2>/dev/null); reportProgress() { trap "reportProgress() { :; }; trap PIPE" PIPE; printf %%s\\\\n "$*" >&4 2>/dev/null; }\n'
	    fi

	    for pieceFile in "${pieceFiles[@]}"
	    do
		pieceInfo="$(getPieceInfo "$pieceFile")"
		modifyPieceFile "$pieceFile" || continue

		printf -v quotedPieceFile '%q' "$pieceFile"
		printf -v quotedPieceInfo '%q' "$pieceInfo"
		interpolatedCommands="${commands:?}"
		interpolatedCommands="${interpolatedCommands//"$fileMarker"/$quotedPieceFile}"
		typeset -a f=("$quotedPieceFile")
		[ "$interpolatedCommands" = "$commands" ] || f=()
		interpolatedCommands="${interpolatedCommands//"$identifierMarker"/$quotedPieceInfo}"

		[ "$hasProgressNotification" ] && [ -n "$progressSink" ] \
		    && printf ' reportProgress %q || :\n' "$pieceInfo"

		printf '%s ' "$interpolatedCommands" "${f[@]}"
		printf '\n'
	    done
	} | ${with:?} "${runWithPromptArgs[@]}"
	;;
    header)
	isHeader=t;&
    '')
	if [ "$hasProgressNotification" ] && [ -n "$progressSink" ]; then
	    exec 4> >("${progressNotificationCommand[@]}" 2>/dev/null)
	    reportProgress()
	    {
		trap 'reportProgress() { :; }; trap PIPE' PIPE
		printf '%s\n' "$*" >&4 2>/dev/null  # Silence "printf: write error: Broken pipe"
	    }
	else
	    reportProgress() { :; }
	fi

	status=
	pieceFileList="${tempDirspec}/${EACHSPLIT_FILE_PREFIX/-/.}list"
	pieceInfoMapping="${tempDirspec}/${EACHSPLIT_FILE_PREFIX/-/.}info.tsv"
	: ${EACHSPLIT_HEADER_ID:="eachSplit-$$-$RANDOM"}
	exec 3<&0
	for pieceFile in "${pieceFiles[@]}"
	do
	    pieceInfo="$(getPieceInfo "$pieceFile")"
	    modifyPieceFile "$pieceFile" || continue
	    if [ -n "$consumerCommands" ]; then
		printf '%s\n' "$pieceFile" >>"$pieceFileList"
		printf '%s\t%s\n' "$pieceFile" "$pieceInfo" >>"$pieceInfoMapping"
	    fi
	    [ -n "$commands" ] || continue

	    printf -v quotedPieceFile '%q' "$pieceFile"
	    printf -v quotedPieceInfo '%q' "$pieceInfo"
	    interpolatedCommands="$commands"
	    interpolatedCommands="${interpolatedCommands//"$fileMarker"/$quotedPieceFile}"
	    [ "$interpolatedCommands" = "$commands" ] || quotedPieceFile=''
	    interpolatedCommands="${interpolatedCommands//"$identifierMarker"/$quotedPieceInfo}"

	    reportProgress "$pieceInfo"
	    (eval "${isHeader:+{}" "$interpolatedCommands" "$quotedPieceFile" "${isHeader:+; \} $errorRedir | withHeader "${colorArg[@]}" --id '$EACHSPLIT_HEADER_ID' -- '$pieceInfo'}") <&3; exitStatus=$?
	    if [ $exitStatus -gt ${status:--1} -a $exitStatus -ne ${additionalSuccessStatus:--1} ]; then
		status=$exitStatus
	    fi
	done

	if [ ${#pieceFiles[@]} -gt 0 -a -n "$consumerCommands" ] \
	    && [ ${status:-${additionalSuccessStatus:-0}} -eq 0 -o ${status:-${additionalSuccessStatus:-0}} -eq ${additionalSuccessStatus:-0} ]
	then
	    printf -v quotedPieceFileList '%q' "$pieceFileList"
	    printf -v quotedGlob '%q/%q*' "$tempDirspec" "$EACHSPLIT_FILE_PREFIX"
	    printf -v quotedPieceInfoMapping '%q' "$pieceInfoMapping"
	    interpolatedConsumerCommands="$consumerCommands"
	    interpolatedConsumerCommands="${interpolatedConsumerCommands//"$fileMarker"/$quotedPieceFileList}"
	    interpolatedConsumerCommands="${interpolatedConsumerCommands//"$globMarker"/$quotedGlob}"
	    interpolatedConsumerCommands="${interpolatedConsumerCommands//"$mappingMarker"/$quotedPieceInfoMapping}"
	    printf -v quotedPieceFiles '%q ' "${pieceFiles[@]}"; quotedPieceFiles="${quotedPieceFiles% }"
	    [ "$interpolatedConsumerCommands" = "$consumerCommands" ] || quotedPieceFiles=''
	    eval "$interpolatedConsumerCommands" "$quotedPieceFiles" || exit $?
	fi

	exit ${status:-${additionalSuccessStatus:-0}}
	;;
    *)	printf >&2 'ASSERT: Invalid strategy: %s\n' "$with"; exit 3;;
esac
