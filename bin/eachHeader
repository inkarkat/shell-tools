#!/bin/bash
shopt -qs extglob

getUsage()
{
    local usageOption="${1:?}"; shift
    typeset -A filteredTopics=([split]=t [piece-info]=t)
    for arg
    do
	[ "${filteredTopics["$arg"]}" ] || set -- "$@" "$arg"
	shift
    done
    [ $# -eq 0 ] || eachSection $usageOption "$@"
}

printUsage()
{
    eachSection --help 2>&1 | sed \
	-e "1s#^.*\$#$(NEWLINE=\\n "${BASH_SOURCE[0]}" --get-usage-description) and execute COMMAND with each section file (which either\nis appended or replaces any {} marker inside COMMANDLINE).#" \
	-e '2b removeFirstParagraphLoop' \
	-e '/^ *\(--section-separator|-S\|--section-\)/b removeOptionLoop' \
	-e '/^Usage:$/N' -e '/\(^\|\n\)Usage: */{ s/\(^\|\n\)\(Usage: *\)\?\(\([^ |]\+ \)*\(| \)\?\)eachSection /\1\2\3[EACHHEADER_STYLE=dashed-line] '"$(basename "$1")"' /; s/ \[-S|--section-separator PATTERN\]//; }' \
	-e b -e :removeFirstParagraphLoop -e '{ /\(^\|\n\)$/{ s/^\(.*\n\)\?//; b; }; N; b removeFirstParagraphLoop; }' \
	-e b -e :removeOptionLoop -e '{ /\n *\(--section-separator|-S\|--section-\)[^\n]*$/{ N; b removeOptionLoop; }; /\n *--[^\n]*$\|\n[^	 ]\|\n$/{ s/^\(.*\n\)\?//; b; }; N; b removeOptionLoop; }'
}
case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
    --get-@(short|long)-usage)
		    getUsage "$@"; exit $?;;
    --get-usage-description)
			shift; printf %s "Split standard input into sections separated by header lines (as created by the${NEWLINE:-$'\n'}[with]Header commands)"; exit 0;;
esac

headerPattern='^\(.*\):$'
case "$EACHHEADER_STYLE" in
    dashed-line)
	headerPattern='^-- \([^[:space:]].*\) --\+$';;
    ?*)	printf >&2 'ERROR: Unknown header style "%s".\n' "$EACHHEADER_STYLE"
	exit 2
	;;
esac

exec eachSection \
    --elide-empty-first \
    --section-separator "$headerPattern" \
    --section-info-extractor-exec sed -n -e "1s/${headerPattern}/\\1/p" "${EACHSPLIT_EXTRACTOR_MARKER:-{\}}" "${EACHSPLIT_EXTRACTOR_END:-;}" \
    --section-modifier-exec sed -i -e '${ /^$/d; }' -- "${EACHSPLIT_MODIFIER_MARKER:-{\}}" "${EACHSPLIT_MODIFIER_END:-;}" \
    --section-info-include-separator above \
    "$@"
